# Both are OPTIONAL — the app defaults to the public Lenz API and works with
# zero config. Override only to point at a local/staging server.

# Base URL for the Lenz public API (keyless). Default: https://lenz.io/api/v1
# VITE_API_BASE=https://lenz.io/api/v1

# Base URL used to build claim links (lenz.io/c/<id>). Default: https://lenz.io
# VITE_LENZ_URL=https://lenz.io
