# All OPTIONAL — the app defaults to the public Lenz API and works with zero
# config. Override only if you need to.

# Base URL for the Lenz public API (keyless). Default: https://lenz.io/api/v1
# VITE_API_BASE=https://lenz.io/api/v1

# Base URL used to build claim links (lenz.io/c/<id>). Default: https://lenz.io
# VITE_LENZ_URL=https://lenz.io

# --- Analytics (all OFF unless VITE_GA_ID is set) ---
# GA4 measurement id. Required to enable analytics.
# VITE_GA_ID=G-XXXXXXXX
# Optional server-side GTM container URL (routes gtag through your own server).
# VITE_GA_SERVER=https://your-sgtm-host
# Optional cookie name for first-external-referrer capture (acquisition).
# VITE_GA_REF_COOKIE=_ref

# --- Deploy (deploy/deploy.sh) ---
# Firebase project id, so deploy.sh doesn't need a --project flag.
# FIREBASE_PROJECT=your-firebase-project
